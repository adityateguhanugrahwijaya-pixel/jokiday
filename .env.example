# JokiDay Environment Configuration Template
# Salin berkas ini ke .env dan isi dengan kredensial rahasia Anda

DATABASE_URL="file:./dev.db"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# Kunci Sesi & Enkripsi (Minimal 32 karakter acak)
SESSION_SECRET="your-super-secret-session-key-at-least-32-chars-long"
ENCRYPTION_KEY="your-32-character-encryption-key-here"
SIGNED_URL_SECRET="your-signed-url-secret-minimum-32-characters"

# Google Drive Integration (OAuth2)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# WaroengPay Payment Gateway Integration
WAROENGPAY_API_KEY="your-waroengpay-api-key"
WAROENGPAY_SECRET="your-waroengpay-secret"
WAROENGPAY_WEBHOOK_SECRET="your-waroengpay-webhook-secret"
WAROENGPAY_BASE_URL="https://waroengpay.com"
PAYMENT_GATEWAY="mock" # "mock" untuk sandbox lokal, "waroengpay" untuk transaksi riil

# Email & Web Push Notifications
EMAIL_FROM="noreply@jokiday.com"
EMAIL_API_KEY="your-email-api-key"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
